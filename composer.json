{
    "name": "hryvinskyi/image-binaries",
    "description": "Image processing binaries (cwebp, cavif, magick) for WebP and AVIF conversion",
    "type": "composer-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "composer-plugin-api": "^2.0"
    },
    "require-dev": {
        "composer/composer": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Hryvinskyi\\ImageBinaries\\": "src/"
        }
    },
    "extra": {
        "class": "Hryvinskyi\\ImageBinaries\\Plugin"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "hryvinskyi/image-binaries": true
        }
    },
    "bin": [
        "bin/install-binaries"
    ]
}
